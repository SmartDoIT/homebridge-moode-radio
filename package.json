  "version": "0.2.0",
  "description": "Siri and HomeKit switches that play favourite radio stations on a moOde audio player",
  "license": "MIT",
  "author": "SmartDoIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SmartDoIT/homebridge-moode-radio.git"
  },
  "bugs": {
    "url": "https://github.com/SmartDoIT/homebridge-moode-radio/issues"
  },
  "keywords": ["homebridge-plugin", "moode", "radio", "mpd", "siri"],
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
